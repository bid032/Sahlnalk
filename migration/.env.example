# انسخ الملف ده وسميه .env (بدون .example)
# املأ القيم من Supabase project الجديد

# من Supabase Dashboard → Project Settings → API
NEW_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEW_SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# من Supabase Dashboard → Project Settings → Database → Connection string
# هيبقى شكله: postgresql://postgres:PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres
NEW_SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres

# القيمة دي موجودة في المشروع الحالي ومش محتاجة تغيير
# لو مش موجودة في ملف .env السكريبت هيستخدم قيمة البيئة تلقائياً
OLD_SUPABASE_DB_URL=
